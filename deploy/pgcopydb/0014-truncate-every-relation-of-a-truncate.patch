+/*
+ * Upwell patch (upwell-14): streamLogicalTransactionAppendTruncateMore adds,
+ * after a TRUNCATE statement, one TRUNCATE statement for each other relation
+ * of the same source TRUNCATE (LogicalMessageTruncate.more).
+ */
+static bool
+streamLogicalTransactionAppendTruncateMore(LogicalTransaction *txn,
+										   LogicalTransactionStatement *stmt)
+{
+	if (stmt->action != STREAM_ACTION_TRUNCATE ||
+		stmt->stmt.truncate.moreCount <= 0)
+	{
+		return true;
+	}
+
+	for (int i = 0; i < stmt->stmt.truncate.moreCount; i++)
+	{
+		LogicalTransactionStatement *more = (LogicalTransactionStatement *)
+											calloc(1, sizeof(LogicalTransactionStatement));
+
+		if (more == NULL)
+		{
+			log_error(ALLOCATION_FAILED_ERROR);
+			return false;
+		}
+
+		more->action = STREAM_ACTION_TRUNCATE;
+		more->xid = stmt->xid;
+		more->lsn = stmt->lsn;
+		strlcpy(more->timestamp, stmt->timestamp, sizeof(more->timestamp));
+		more->stmt.truncate.table = stmt->stmt.truncate.more[i];
+
+		if (!streamLogicalTransactionAppendStatement(txn, more))
+		{
+			return false;
+		}
+	}
+
+	stmt->stmt.truncate.moreCount = 0;
+
+	return true;
+}
