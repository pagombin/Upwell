+/*
+ * Upwell patch (upwell-14): stream_apply_truncate_cascade appends CASCADE to
+ * a replicated TRUNCATE. The source truncates every table that references a
+ * truncated one in the same command (or the TRUNCATE fails there), and each
+ * of them now arrives as a statement of its own: on the target each one
+ * alone would be refused for the foreign keys of the others. CASCADE reaches
+ * only tables the source truncated too, since the schemas are the same.
+ */
+static void
+stream_apply_truncate_cascade(char *dst, size_t size, const char *sql)
+{
+	strlcpy(dst, sql, size);
+
+	size_t len = strlen(dst);
+
+	while (len > 0 && (dst[len - 1] == ';' || dst[len - 1] == '\n' ||
+					   dst[len - 1] == ' '))
+	{
+		dst[--len] = '\0';
+	}
+
+	strlcat(dst, " CASCADE", size);
+}
