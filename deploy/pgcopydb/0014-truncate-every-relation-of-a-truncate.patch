+/*
+ * Upwell patch (upwell-14): parseTestDecodingTruncateTables reads every
+ * relation of a TRUNCATE message, which test_decoding lists in one header:
+ *
+ * table public.tp, public.tp_a, "we, ird".x: TRUNCATE: (no-flags)
+ *
+ * The header parser took everything up to the colon as one table name, so a
+ * TRUNCATE of several tables (a partitioned table and its partitions, "a, b",
+ * CASCADE) failed or truncated the wrong relation. Names keep test_decoding's
+ * quoting.
+ */
+bool
+parseTestDecodingTruncateTables(const char *message,
+								LogicalMessageRelation **tables, int *count)
+{
+	*tables = NULL;
+	*count = 0;
+
+	if (message == NULL || strncmp(message, "table ", 6) != 0)
+	{
+		log_error("Failed to parse test_decoding TRUNCATE message: %s", message);
+		return false;
+	}
+
+	const char *p = message + 6;
+	int cap = 0;
+
+	for (;;)
+	{
+		const char *start[2] = { p, NULL };
+		const char *stop[2] = { NULL, NULL };
+		bool inQuotes = false;
+		int part = 0;
+
+		for (; *p != '\0'; p++)
+		{
+			if (*p == '"')
+			{
+				inQuotes = !inQuotes;
+			}
+			else if (!inQuotes && part == 0 && *p == '.')
+			{
+				stop[0] = p;
+				start[1] = p + 1;
+				part = 1;
+			}
+			else if (!inQuotes && part == 1 && (*p == ',' || *p == ':'))
+			{
+				stop[1] = p;
+				break;
+			}
+		}
+
+		if (stop[0] == NULL || stop[1] == NULL)
+		{
+			log_error("Failed to parse test_decoding TRUNCATE message: %s",
+					  message);
+			return false;
+		}
+
+		if (*count == cap)
+		{
+			cap = cap == 0 ? 4 : cap * 2;
+			*tables = realloc(*tables, cap * sizeof(LogicalMessageRelation));
+
+			if (*tables == NULL)
+			{
+				log_error(ALLOCATION_FAILED_ERROR);
+				return false;
+			}
+		}
+
+		(*tables)[*count].nspname = strndup(start[0], stop[0] - start[0]);
+		(*tables)[*count].relname = strndup(start[1], stop[1] - start[1]);
+		++(*count);
+
+		if (*p == ':')
+		{
+			return true;
+		}
+
+		/* skip ", " */
+		p++;
+		while (*p == ' ')
+		{
+			p++;
+		}
+	}
+}
