+/*
+ * Upwell patch (upwell-14): parsePgoutputTruncateList decodes the relations
+ * of a TRUNCATE kept by the receive ("<len>:<schema><len>:<table>" for each),
+ * as quoted identifiers.
+ */
+bool
+parsePgoutputTruncateList(const char *list,
+						  LogicalMessageRelation **tables, int *count)
+{
+	*tables = NULL;
+	*count = 0;
+
+	int cap = 0;
+	const char *p = list;
+
+	while (p != NULL && *p != '\0')
+	{
+		char *name[2] = { NULL, NULL };
+
+		for (int k = 0; k < 2; k++)
+		{
+			char *colon = NULL;
+			unsigned long len = strtoul(p, &colon, 10);
+
+			if (colon == p || *colon != ':' || strlen(colon + 1) < len)
+			{
+				log_error("pgoutput: malformed TRUNCATE relation list: %s", list);
+				return false;
+			}
+
+			char *raw = strndup(colon + 1, len);
+			name[k] = raw != NULL ? quote_and_dup(raw) : NULL;
+			free(raw);
+
+			if (name[k] == NULL)
+			{
+				log_error(ALLOCATION_FAILED_ERROR);
+				return false;
+			}
+			p = colon + 1 + len;
+		}
+
+		if (*count == cap)
+		{
+			cap = cap == 0 ? 4 : cap * 2;
+			*tables = realloc(*tables, cap * sizeof(LogicalMessageRelation));
+
+			if (*tables == NULL)
+			{
+				log_error(ALLOCATION_FAILED_ERROR);
+				return false;
+			}
+		}
+
+		(*tables)[*count].nspname = name[0];
+		(*tables)[*count].relname = name[1];
+		++(*count);
+	}
+
+	return true;
+}
