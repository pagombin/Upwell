+			catalog->db = NULL;
+			return false;
+		}
+
+		int hasSeq = 0;
+		sqlite3_stmt *seqStmt = NULL;
+
+		if (sqlite3_prepare_v2(catalog->db,
+							   "select count(*) from pragma_table_info('output') "
+							   " where name = 'seq'",
+							   -1, &seqStmt, NULL) == SQLITE_OK &&
+			sqlite3_step(seqStmt) == SQLITE_ROW)
+		{
+			hasSeq = sqlite3_column_int(seqStmt, 0);
+		}
+		(void) sqlite3_finalize(seqStmt);
+
+		if ((!hasSeq &&
+			 (!catalog_execute(catalog,
+							   "alter table output "
+							   "add column seq integer not null default 0") ||
+			  !catalog_execute(catalog, "drop index if exists o_a_lsn") ||
+			  !catalog_execute(catalog,
+							   "create unique index o_a_lsn_seq "
+							   "on output(action, lsn, seq)"))) ||
+			!catalog_execute(catalog, "COMMIT"))
+		{
+			/* errors have already been logged */
+			(void) catalog_execute(catalog, "ROLLBACK");
+			sqlite3_close(catalog->db);
+			catalog->db = NULL;
+			return false;
+		}
+
 		if (!catalog_execute(catalog,
 							 "create index if not exists o_xid on output(xid)"))
