 	if (!createSchema && catalog->type == DATABASE_CATALOG_TYPE_OUTPUT)
 	{
+		/*
+		 * Upwell patch (upwell-11): a file made by an older build is keyed
+		 * on (action, lsn), which keeps one of the rows that share an LSN.
+		 * Give it the seq column and the (action, lsn, seq) key. The two
+		 * processes may open the file at once: the check and the change
+		 * are one write transaction.
+		 */
+		if (!catalog_execute(catalog, "BEGIN IMMEDIATE"))
