diff --git a/src/bin/pgcopydb/ld_store.c b/src/bin/pgcopydb/ld_store.c
index daeffd7..9b3772b 100644
--- a/src/bin/pgcopydb/ld_store.c
+++ b/src/bin/pgcopydb/ld_store.c
@@ -1689,6 +1689,29 @@ static bool ld_store_insert_pgoutput_message_one(DatabaseCatalog *catalog,
 static bool ld_store_insert_internal_message_one(DatabaseCatalog *catalog,
 												 InternalMessage *message);
 
+/*
+ * Upwell patch (upwell-11): ld_store_output_seq numbers the messages of one
+ * action that share an LSN. A COPY writes the rows of a page in one WAL
+ * record, so every row decoded from it carries the record's LSN, and the
+ * output table, keyed on (action, lsn) with INSERT OR REPLACE, kept only
+ * the last of them: a COPY of 20,000 rows arrived as 172. The key is now
+ * (action, lsn, seq). After a restart the slot sends whole transactions
+ * again, in the same order, so a message sent again gets the same seq and
+ * still replaces its first copy.
+ */
+static int64_t
+ld_store_output_seq(DatabaseCatalog *catalog, LogicalMessageMetadata *metadata)
+{
+	if (metadata->lsn != catalog->seqLSN)
+	{
+		catalog->seqLSN = metadata->lsn;
+		memset(catalog->seqCount, 0, sizeof(catalog->seqCount));
+	}
+
+	return catalog->seqCount[metadata->action & 0x7f]++;
+}
+
+
 static bool
 ld_store_output_batch_begin(DatabaseCatalog *catalog)
 {
