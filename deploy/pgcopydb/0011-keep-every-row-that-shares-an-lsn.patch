-		"insert or replace into output(action, xid, lsn, timestamp, message)"
-		"values($1, $2, $3, $4, $5) ";
+		"insert or replace into output(action, xid, lsn, timestamp, message, seq)"
+		"values($1, $2, $3, $4, $5, $6) ";
 
 	if (!semaphore_lock(&(catalog->sema)))
