diff --git a/src/bin/pgcopydb/catalog.c b/src/bin/pgcopydb/catalog.c
index 2d28495..97fb105 100644
--- a/src/bin/pgcopydb/catalog.c
+++ b/src/bin/pgcopydb/catalog.c
@@ -1519,6 +1519,28 @@ catalog_init(DatabaseCatalog *catalog)
 		return false;
 	}
 
+	/*
+	 * Upwell patch (upwell-6): the receive and apply processes share the CDC
+	 * files (output, replay). Without a busy timeout, a statement that finds
+	 * the other one writing fails at once with "database is locked", and the
+	 * whole engine with it, for example the index created when an existing
+	 * CDC file is opened. Wait up to two minutes, as for the catalog lock
+	 * (upwell-2). The source catalog keeps its own semaphore and retries: a
+	 * busy timeout there let the sequence step wait out a reader that holds
+	 * its read lock for as long.
+	 */
+	if ((catalog->type == DATABASE_CATALOG_TYPE_OUTPUT ||
+		 catalog->type == DATABASE_CATALOG_TYPE_REPLAY) &&
+		sqlite3_busy_timeout(catalog->db, 120 * 1000) != SQLITE_OK)
+	{
+		log_error("Failed to set a busy timeout on \"%s\": %s",
+				  catalog->dbfile,
+				  sqlite3_errmsg(catalog->db));
+		sqlite3_close(catalog->db);
+		catalog->db = NULL;
+		return false;
+	}
+
 	/*
 	 * The source catalog needs a semaphore to serialize concurrent write
 	 * access to the SQLite database.
