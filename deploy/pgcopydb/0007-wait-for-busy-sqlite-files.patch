diff --git a/src/bin/pgcopydb/catalog.c b/src/bin/pgcopydb/catalog.c
index 2d28495..3b3ebb1 100644
--- a/src/bin/pgcopydb/catalog.c
+++ b/src/bin/pgcopydb/catalog.c
@@ -1519,6 +1519,24 @@ catalog_init(DatabaseCatalog *catalog)
 		return false;
 	}
 
+	/*
+	 * Upwell patch (upwell-6): several processes open these files (receive
+	 * and apply share the CDC files). Without a busy timeout, a statement
+	 * that finds another process writing fails at once with "database is
+	 * locked", and the whole engine with it, for example when opening a CDC
+	 * file the receive process is writing. Wait up to two minutes, as for
+	 * the catalog lock (upwell-2).
+	 */
+	if (sqlite3_busy_timeout(catalog->db, 120 * 1000) != SQLITE_OK)
+	{
+		log_error("Failed to set a busy timeout on \"%s\": %s",
+				  catalog->dbfile,
+				  sqlite3_errmsg(catalog->db));
+		sqlite3_close(catalog->db);
+		catalog->db = NULL;
+		return false;
+	}
+
 	/*
 	 * The source catalog needs a semaphore to serialize concurrent write
 	 * access to the SQLite database.
