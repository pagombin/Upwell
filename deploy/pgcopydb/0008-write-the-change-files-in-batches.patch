+		action == STREAM_ACTION_INSERT ||
+		action == STREAM_ACTION_UPDATE ||
+		action == STREAM_ACTION_DELETE ||
+		action == STREAM_ACTION_TRUNCATE ||
+		action == STREAM_ACTION_MESSAGE;
+
+	if (inTransaction && ++catalog->batchCount < OUTPUT_BATCH_MESSAGES)
+	{
