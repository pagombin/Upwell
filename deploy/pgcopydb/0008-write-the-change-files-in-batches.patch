+		catalog->batchOpen = false;
+		catalog->batchCount = 0;
+		(void) catalog_execute(catalog, "ROLLBACK");
+	}
+}
+
+
+static bool
+ld_store_output_batch_end(DatabaseCatalog *catalog, StreamAction action)
+{
+	bool inTransaction =
