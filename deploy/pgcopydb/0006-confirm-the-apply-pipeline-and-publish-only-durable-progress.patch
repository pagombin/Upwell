+/*
+ * Upwell patch (upwell-6): the apply connection runs in libpq pipeline mode,
+ * and pgcopydb 0.18 never read the target's answers on it. An error on the
+ * target (after which the server ignores everything until a Sync) went
+ * unnoticed; the send buffer grew with the backlog until libpq gave up
+ * ("cannot allocate memory for output buffer"); and sentinel.replay_lsn,
+ * which the receive process reports to the source as flushed, advanced with
+ * what had only been queued. The pipeline is now synced every
+ * APPLY_SYNC_STATEMENTS statements, APPLY_SYNC_BYTES bytes or
+ * APPLY_SYNC_INTERVAL_MS, and before anything is published. A refused
+ * statement stops the apply, and replay_lsn only moves to positions the
+ * target has durably committed.
+ */
+#define APPLY_SYNC_STATEMENTS 1000
+#define APPLY_SYNC_BYTES (64 * 1024 * 1024)
+#define APPLY_SYNC_INTERVAL_MS 500
+
+static uint64_t applyPendingStmts = 0;
+static uint64_t applyPendingBytes = 0;
+static uint64_t applyLastSyncMs = 0;
+static bool applyFailed = false;
+
+/* the last COMMIT queued, and the last replay_lsn published */
+static uint64_t applyQueuedCommitLSN = InvalidXLogRecPtr;
+static uint64_t applyPublishedLSN = InvalidXLogRecPtr;
+
+static uint64_t
+stream_apply_now_ms(void)
+{
+	struct timespec ts;
+
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+
+	return (uint64_t) ts.tv_sec * 1000 + (uint64_t) ts.tv_nsec / 1000000;
+}
+
+
+static void
+stream_apply_queued(uint64_t bytes)
+{
+	applyPendingStmts++;
+	applyPendingBytes += bytes;
+}
+
+
+/*
+ * stream_apply_confirm reads the target's answers to everything queued on the
+ * apply connection: always when force is true, otherwise once a threshold is
+ * reached. It returns false when the target refused a statement.
+ */
+static bool
+stream_apply_confirm(StreamApplyContext *context, bool force)
+{
+	if (applyFailed)
+	{
+		return false;
+	}
+
+	if (applyPendingStmts == 0)
+	{
+		return true;
+	}
+
+	if (!force &&
+		applyPendingStmts < APPLY_SYNC_STATEMENTS &&
+		applyPendingBytes < APPLY_SYNC_BYTES &&
+		stream_apply_now_ms() - applyLastSyncMs < APPLY_SYNC_INTERVAL_MS)
+	{
+		return true;
+	}
+
+	if (!pgsql_sync_pipeline(&(context->applyPgConn)))
+	{
+		log_error("The target did not apply a change, see above for details; "
+				  "progress stays at %X/%X",
+				  LSN_FORMAT_ARGS(applyPublishedLSN));
+		applyFailed = true;
+		return false;
+	}
+
+	applyPendingStmts = 0;
+	applyPendingBytes = 0;
+	applyLastSyncMs = stream_apply_now_ms();
+
+	return true;
+}
