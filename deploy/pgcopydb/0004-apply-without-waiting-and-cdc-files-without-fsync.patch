diff --git a/src/bin/pgcopydb/catalog.c b/src/bin/pgcopydb/catalog.c
index 8d6e810..3f61ddf 100644
--- a/src/bin/pgcopydb/catalog.c
+++ b/src/bin/pgcopydb/catalog.c
@@ -1529,6 +1529,28 @@ catalog_init(DatabaseCatalog *catalog)
 		return false;
 	}
 
+	/*
+	 * Upwell patch (upwell-4): the CDC files (output and replay) are not the
+	 * durable record of the stream. The replication slot is: a restart
+	 * streams again from the slot, which only advances to what the apply has
+	 * committed on the target. A full fsync after every decoded message (one
+	 * per row, twice: output then replay) capped the receive process at a
+	 * few hundred rows a second on a droplet's disk. In WAL mode, NORMAL
+	 * still keeps the file consistent; a power loss can only lose the last
+	 * commits, which the slot sends again.
+	 */
+	if (catalog->type == DATABASE_CATALOG_TYPE_OUTPUT ||
+		catalog->type == DATABASE_CATALOG_TYPE_REPLAY)
+	{
+		if (!catalog_execute(catalog, "PRAGMA synchronous = NORMAL"))
+		{
+			/* errors have already been logged */
+			sqlite3_close(catalog->db);
+			catalog->db = NULL;
+			return false;
+		}
+	}
+
 	if (createSchema)
 	{
 		/*
